# Exemplo — copie para /etc/nginx/secrets/danferapida.key.conf no servidor
# e preencha com a sua API key do danferapida.com.br.
#
#   sudo mkdir -p /etc/nginx/secrets
#   sudo cp danferapida.key.conf.example /etc/nginx/secrets/danferapida.key.conf
#   sudo nano /etc/nginx/secrets/danferapida.key.conf
#   sudo chmod 600 /etc/nginx/secrets/danferapida.key.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Este arquivo NÃO vai para o git (ver .gitignore).

proxy_set_header x-api-key "COLOQUE_SUA_API_KEY_AQUI";
